# S3-совместимое хранилище lakehouse (SeaweedFS)
S3_ACCESS_KEY=lakeadmin
S3_SECRET_KEY=lakesecret123
LAKE_BUCKET=lakehouse

# Airflow (ключ Fernet сгенерируйте сами, см. README)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_FERNET_KEY=ZmRzYWZkc2FmZHNhZmRzYWZkc2FmZHNhZmRzYWZkc2E=
AIRFLOW_DB_PASSWORD=airflow

# Источник данных (adsb.lol, открытый ADS-B API без ключа)
POLL_INTERVAL_SEC=60

# Локальная LLM (Ollama на хосте)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
